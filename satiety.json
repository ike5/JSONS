{
  "scale": {
    "min": 1,
    "max": 10
  },
  "dimension_definitions": {
    "fullness_index": "How full a typical person feels immediately after eating a serving",
    "duration": "How long the feeling of fullness lasts before hunger returns (hours",
    "caloric_efficiency": "How much satiety you get per calorie consumed (satiety_per_calorie",
    "volume": "Physical volume of food per serving (high volume = more stomach stretch",
    "glycemic_impact": "How stable blood sugar remains after eating (crash = less satiety"
  },
  "scoring": {
    "weights": {
      "fullness_index": 0.30,
      "duration": 0.25,
      "caloric_efficiency": 0.20,
      "volume": 0.10,
      "glycemic_impact": 0.15
    },
    "method": "weighted_sum_scaled_to_10"
  },
  "anchors": {
    "celery_sticks": 1,
    "green_salad_no_protein": 2,
    "oatmeal_with_nuts": 5,
    "steak_with_potatoes": 8,
    "chili_with_beans_and_meat": 10
  },
  "note": "Score 1 = least satiating, 10 = most satiating",
  "item_scoring": {
    "fullness_index": {
      "still_very_hungry_after_serving": 1,
      "slightly_less_hungry": 2,
      "partially_satisfied": 4,
      "mostly_full": 6,
      "very_full": 8,
      "completely_stuffed": 10
    },
    "duration": {
      "under_1_hour": 1,
      "1_to_2_hours": 2,
      "2_to_3_hours": 4,
      "3_to_4_hours": 6,
      "4_to_6_hours": 8,
      "over_6_hours": 10
    },
    "caloric_efficiency": {
      "very_poor_lots_of_calories_no_satiety": 1,
      "poor": 2,
      "below_average": 4,
      "average": 5,
      "good": 7,
      "excellent_high_satiety_low_calories": 10
    },
    "volume": {
      "very_small_serving": 1,
      "small_serving": 2,
      "moderate_serving": 4,
      "generous_serving": 6,
      "large_serving": 8,
      "very_large_heavy_serving": 10
    },
    "glycemic_impact": {
      "rapid_spike_and_crash": 1,
      "significant_spike_then_drop": 3,
      "moderate_rise_gradual_decline": 5,
      "steady_release_minor_fluctuation": 7,
      "very_stable_blood_sugar": 10
    }
  }
}