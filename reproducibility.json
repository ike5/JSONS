{
  "scale": {
    "min": 1,
    "max": 10
  },
  "dimension_definitions": {
    "instruction_precision": "How clearly and completely the recipe is written (ambiguity = high score = hard to reproduce",
    "ingredient_specificity": "How precisely ingredients are specified (brand, variety, ripeness, etc.",
    "environmental_sensitivity": "How much altitude, humidity, oven variance, etc. affect the result",
    "technique_dependence": "How much the result depends on the cook's technique vs following instructions",
    "measurement_tolerance": "How precise measurements need to be for success"
  },
  "scoring": {
    "weights": {
      "instruction_precision": 0.25,
      "ingredient_specificity": 0.20,
      "environmental_sensitivity": 0.20,
      "technique_dependence": 0.20,
      "measurement_tolerance": 0.15
    },
    "method": "weighted_sum_scaled_to_10"
  },
  "anchors": {
    "boil_water": 1,
    "boxed_mac_and_cheese": 2,
    "chocolate_chip_cookies": 3,
    "sourdough_bread": 7,
    "tempered_chocolate": 10
  },
  "item_scoring": {
